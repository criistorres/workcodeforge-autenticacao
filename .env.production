# ===========================================
# WORKCODEFORE - PRODUCTION ENVIRONMENT
# ===========================================
# Este arquivo contém as variáveis para produção
# Domínio: workcodeforge.com.br
#
# ⚠️  ATENÇÃO: NUNCA COMMITE ESTE ARQUIVO NO GIT!
# ⚠️  Este arquivo deve ser copiado manualmente para a VPS
# ===========================================

# Domínio principal (PRODUÇÃO)
DOMAIN=workcodeforge.com.br

# Server Information
SERVER_NAME=WorkCodeForge
SERVER_MOTD=Bem-vindo ao WorkCodeForge
SERVER_ICON=

DEBUG_MODE=false
JITSI_URL=meet.jit.si
JITSI_PRIVATE_MODE=false
JITSI_ISS=
SECRET_JITSI_KEY=

# Jitsi low-level API settings
JITSI_DOMAIN=
JITSI_XMPP_DOMAIN=
JITSI_MUC_DOMAIN=

# LiveKit (PRODUÇÃO - CONFIGURE SEUS VALORES)
LIVEKIT_HOST=https://livekit.workcodeforge.com.br
LIVEKIT_API_KEY=CHANGE_ME_IN_PRODUCTION
LIVEKIT_API_SECRET=CHANGE_ME_IN_PRODUCTION

# BigBlueButton (CONFIGURE SUA INSTÂNCIA)
BBB_URL=https://test-install.blindsidenetworks.com/bigbluebutton/
BBB_SECRET=8cd8ef52e8e101574e400365b55e11a6

# Admin API
ADMIN_API_URL=
ADMIN_API_TOKEN=CHANGE_ME_IN_PRODUCTION

# Map URLs (PRODUÇÃO)
START_ROOM_URL=/_/global/maps.workcodeforge.com.br/starter/map.json
LOBBY_MAP_URL=/_/global/maps.workcodeforge.com.br/starter/chatzone.json
MAIN_MAP_URL=/_/global/maps.workcodeforge.com.br/starter/map.json
MAP_STORAGE_URL=map-storage:50053

# STUN/TURN
STUN_SERVER=stun:stun.l.google.com:19302
WHITELISTED_RESOURCE_URLS=""
TURN_STATIC_AUTH_SECRET=
TURN_SERVER=

DISABLE_NOTIFICATIONS=false
SKIP_RENDER_OPTIMIZATIONS=false

# ===========================================
# LET'S ENCRYPT - SSL/TLS (PRODUÇÃO)
# ===========================================
ACME_EMAIL=seu-email@workcodeforge.com.br

# Limits
MAX_PER_GROUP=100
MAX_USERNAME_LENGTH=10

# Bandwidth settings
PEER_VIDEO_LOW_BANDWIDTH=150
PEER_VIDEO_RECOMMENDED_BANDWIDTH=150
PEER_SCREEN_SHARE_LOW_BANDWIDTH=250
PEER_SCREEN_SHARE_RECOMMENDED_BANDWIDTH=1000

# ===========================================
# OPENID CONNECT - CUSTOM AUTH (PRODUÇÃO)
# ===========================================
# ⚠️  IMPORTANTE: Gere novos secrets fortes para produção!
OPENID_CLIENT_ID=workadventure-production
OPENID_CLIENT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET_FOR_PRODUCTION
OPENID_CLIENT_ISSUER=https://auth.workcodeforge.com.br
OPENID_PROFILE_SCREEN_PROVIDER=
OPENID_PROMPT=login
OPENID_LOCALE_CLAIM=
OPENID_LOGOUT_REDIRECT_URL=https://play.workcodeforge.com.br
DISABLE_ANONYMOUS=true
OPENID_SCOPE=openid email profile
OPENID_USERNAME_CLAIM=name
OPENID_TAGS_CLAIM=tags

# Woka name policy
OPID_WOKA_NAME_POLICY=allow_override_opid

# Contact page
CONTACT_URL=

# Prometheus (PRODUÇÃO)
PROMETHEUS_AUTHORIZATION_TOKEN=CHANGE_ME_IN_PRODUCTION
PROMETHEUS_URL=http://prometheus:9090

# Player variables
PLAYER_VARIABLES_MAX_TTL=-1

# ===========================================
# MAP EDITOR
# ===========================================
ENABLE_MAP_EDITOR=true
MAP_EDITOR_ALLOWED_USERS=
MAP_EDITOR_ALLOW_ALL_USERS=true

# ===========================================
# UPLOADER SERVICE (PRODUÇÃO)
# ===========================================
UPLOADER_REDIS_HOST=redis
UPLOADER_REDIS_PORT=6379
UPLOADER_REDIS_DB_NUMBER=1

# AWS (Opcional - descomente se usar S3)
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=workadventure-bucket
# AWS_ENDPOINT=https://s3.amazonaws.com
# UPLOADER_AWS_SIGNED_URL_EXPIRATION=60

# ===========================================
# CHAT SETTINGS
# ===========================================
MAX_HISTORY_CHAT=30
EMBEDLY_KEY=
IFRAMELY_KEY=
ENABLE_CHAT=true
ENABLE_CHAT_UPLOAD=true
ENABLE_CHAT_ONLINE_LIST=true
ENABLE_CHAT_DISCONNECTED_LIST=true
UPLOAD_MAX_FILESIZE=10485760

# ===========================================
# SECURITY - JWT (PRODUÇÃO)
# ===========================================
# ⚠️  CRÍTICO: Gere um secret forte e único!
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_JWT_SECRET_FOR_PRODUCTION

# ===========================================
# DATABASE - PostgreSQL (PRODUÇÃO)
# ===========================================
# ⚠️  IMPORTANTE: Senha do banco de dados PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_DB_PASSWORD_FOR_PRODUCTION

# ===========================================
# NODE ENVIRONMENT
# ===========================================
NODE_ENV=production

# ===========================================
# URLs PRINCIPAIS (PRODUÇÃO)
# ===========================================
PLAY_URL=https://play.workcodeforge.com.br
FRONT_URL=https://play.workcodeforge.com.br
PUSHER_URL=https://play.workcodeforge.com.br

# Report issues
ENABLE_REPORT_ISSUES_MENU=true
REPORT_ISSUES_URL=https://github.com/seu-usuario/workcodefore/issues

# Monitoring (PRODUÇÃO)
LOGROCKET_ID=

# Sentry (configure para monitoramento em produção)
SENTRY_DSN_FRONT=
SENTRY_DSN_PUSHER=
SENTRY_DSN_MAPSTORAGE=
SENTRY_DSN_BACK=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=production
SENTRY_ORG=
SENTRY_PROJECT=

# RoomAPI
ROOM_API_SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# ===========================================
# INTEGRATIONS
# ===========================================
KLAXOON_ENABLED=false
KLAXOON_CLIENT_ID=
YOUTUBE_ENABLED=true
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DOCS_ENABLED=true
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SLIDES_ENABLED=true
ERASER_ENABLED=true
EXCALIDRAW_ENABLED=true
EXCALIDRAW_DOMAINS=
CARDS_ENABLED=true
EMBEDDED_DOMAINS_WHITELIST=

# Google Drive Picker
GOOGLE_DRIVE_PICKER_CLIENT_ID=
GOOGLE_DRIVE_PICKER_APP_ID=

# gRPC
GRPC_MAX_MESSAGE_SIZE=20971520

# WebRTC
MAX_USERS_FOR_WEBRTC=4

# ===========================================
# INSTRUÇÕES PARA GERAR SECRETS FORTES:
# ===========================================
# Execute os comandos abaixo para gerar secrets seguros:
#
# openssl rand -base64 32
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Ou use o script automatizado:
# bash scripts/generate-secrets.sh
#
# Secrets que precisam ser gerados:
# - OPENID_CLIENT_SECRET
# - SECRET_KEY
# - POSTGRES_PASSWORD
# - ROOM_API_SECRET_KEY
# - ADMIN_API_TOKEN
# - PROMETHEUS_AUTHORIZATION_TOKEN
# - LIVEKIT_API_KEY
# - LIVEKIT_API_SECRET
#
# Depois substitua os valores marcados com CHANGE_ME
# ===========================================
