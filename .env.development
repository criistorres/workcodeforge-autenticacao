# ===========================================
# WORKCODEFORE - DEVELOPMENT ENVIRONMENT
# ===========================================
# Este arquivo contém as variáveis para desenvolvimento local
# Domínio: *.workadventure.localhost

# Domínio principal
DOMAIN=workadventure.localhost

# Server Information
SERVER_NAME=WorkCodeForge - Dev
SERVER_MOTD=Ambiente de Desenvolvimento
SERVER_ICON=

DEBUG_MODE=true
JITSI_URL=meet.jit.si
JITSI_PRIVATE_MODE=false
JITSI_ISS=
SECRET_JITSI_KEY=

# Jitsi low-level API settings
JITSI_DOMAIN=
JITSI_XMPP_DOMAIN=
JITSI_MUC_DOMAIN=

# LiveKit (desenvolvimento)
LIVEKIT_HOST=http://livekit.workadventure.localhost
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=12345678901234567890123456789012

# BigBlueButton (test instance)
BBB_URL=https://test-install.blindsidenetworks.com/bigbluebutton/
BBB_SECRET=8cd8ef52e8e101574e400365b55e11a6

# Admin API
ADMIN_API_URL=
ADMIN_API_TOKEN=123

# Map URLs (local development)
START_ROOM_URL=/_/global/maps.workadventure.localhost/starter/map.json
LOBBY_MAP_URL=/_/global/maps.workadventure.localhost/starter/chatzone.json
MAIN_MAP_URL=/_/global/maps.workadventure.localhost/starter/map.json
MAP_STORAGE_URL=map-storage:50053

# STUN/TURN
STUN_SERVER=stun:stun.l.google.com:19302
WHITELISTED_RESOURCE_URLS=""
TURN_STATIC_AUTH_SECRET=
TURN_SERVER=

DISABLE_NOTIFICATIONS=true
SKIP_RENDER_OPTIMIZATIONS=false

# Let's Encrypt (não usado em dev)
ACME_EMAIL=

# Limits
MAX_PER_GROUP=100
MAX_USERNAME_LENGTH=10

# Bandwidth settings
PEER_VIDEO_LOW_BANDWIDTH=150
PEER_VIDEO_RECOMMENDED_BANDWIDTH=150
PEER_SCREEN_SHARE_LOW_BANDWIDTH=250
PEER_SCREEN_SHARE_RECOMMENDED_BANDWIDTH=1000

# ===========================================
# OPENID CONNECT - CUSTOM AUTH (DESENVOLVIMENTO)
# ===========================================
OPENID_CLIENT_ID=workadventure-local
OPENID_CLIENT_SECRET=my-super-secret-key-for-local-dev
OPENID_CLIENT_ISSUER=http://auth.workadventure.localhost
OPENID_PROFILE_SCREEN_PROVIDER=
OPENID_PROMPT=login
OPENID_LOCALE_CLAIM=
OPENID_LOGOUT_REDIRECT_URL=http://play.workadventure.localhost
DISABLE_ANONYMOUS=true
OPENID_SCOPE=openid email profile
OPENID_USERNAME_CLAIM=name
OPENID_TAGS_CLAIM=tags

# Woka name policy
OPID_WOKA_NAME_POLICY=allow_override_opid

# Contact page
CONTACT_URL=

# Prometheus
PROMETHEUS_AUTHORIZATION_TOKEN=
PROMETHEUS_URL=http://localhost:9090

# Player variables
PLAYER_VARIABLES_MAX_TTL=-1

# ===========================================
# MAP EDITOR
# ===========================================
ENABLE_MAP_EDITOR=true
MAP_EDITOR_ALLOWED_USERS=
MAP_EDITOR_ALLOW_ALL_USERS=true

# ===========================================
# UPLOADER SERVICE
# ===========================================
# Redis para desenvolvimento
UPLOADER_REDIS_HOST=redis
UPLOADER_REDIS_PORT=6379
UPLOADER_REDIS_DB_NUMBER=1

# ===========================================
# CHAT SETTINGS
# ===========================================
MAX_HISTORY_CHAT=0
EMBEDLY_KEY=
IFRAMELY_KEY=
ENABLE_CHAT=true
ENABLE_CHAT_UPLOAD=true
ENABLE_CHAT_ONLINE_LIST=true
ENABLE_CHAT_DISCONNECTED_LIST=true
UPLOAD_MAX_FILESIZE=10485760

# ===========================================
# SECURITY - JWT (DESENVOLVIMENTO)
# ===========================================
SECRET_KEY=yourSecretKey2020-dev

# Report issues
ENABLE_REPORT_ISSUES_MENU=false
REPORT_ISSUES_URL=

# Monitoring
LOGROCKET_ID=

# Sentry (desabilitado em dev)
SENTRY_DSN_FRONT=
SENTRY_DSN_PUSHER=
SENTRY_DSN_MAPSTORAGE=
SENTRY_DSN_BACK=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=

# RoomAPI
ROOM_API_SECRET_KEY=dev-room-api-secret

# ===========================================
# INTEGRATIONS
# ===========================================
KLAXOON_ENABLED=false
KLAXOON_CLIENT_ID=
YOUTUBE_ENABLED=true
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DOCS_ENABLED=true
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SLIDES_ENABLED=true
ERASER_ENABLED=true
EXCALIDRAW_ENABLED=true
EXCALIDRAW_DOMAINS=
CARDS_ENABLED=true
EMBEDDED_DOMAINS_WHITELIST=

# Google Drive Picker
GOOGLE_DRIVE_PICKER_CLIENT_ID=
GOOGLE_DRIVE_PICKER_APP_ID=

# gRPC
GRPC_MAX_MESSAGE_SIZE=20971520

# WebRTC
MAX_USERS_FOR_WEBRTC=4

# ===========================================
# OAUTH REDIRECT URI MAPPING (for SSO)
# ===========================================
# Map redirect URIs to their respective services for proper OAuth state tracking
# Development configuration with localhost subdomains
PLAY_REDIRECT_URI=http://play.workadventure.localhost/openid-callback
MATRIX_REDIRECT_URI=http://matrix.workadventure.localhost/_synapse/client/oidc/callback
